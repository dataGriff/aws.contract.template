{
  "name": "@datagriff/todo-api-contract",
  "version": "0.0.0",
  "description": "The Todo API contract: OpenAPI spec, generated types, zod schemas, a typed fetch client and a ready-to-run .http collection",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/dataGriff/aws.contract.template.git"
  },
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "api/openapi.yaml",
    "collections"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./zod": {
      "import": {
        "types": "./dist/zod.d.ts",
        "default": "./dist/zod.js"
      },
      "require": {
        "types": "./dist/zod.d.cts",
        "default": "./dist/zod.cjs"
      }
    },
    "./types": {
      "import": {
        "types": "./dist/types.d.ts",
        "default": "./dist/types.js"
      },
      "require": {
        "types": "./dist/types.d.cts",
        "default": "./dist/types.cjs"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/client.d.ts",
        "default": "./dist/client.js"
      },
      "require": {
        "types": "./dist/client.d.cts",
        "default": "./dist/client.cjs"
      }
    },
    "./openapi.yaml": "./api/openapi.yaml",
    "./collections/*": "./collections/*",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "scripts": {
    "gen": "kubb generate --config kubb.config.ts",
    "build": "tsup",
    "prepare": "lefthook install 2>/dev/null || echo 'lefthook not on PATH (run `mise install` then `task hooks:install`)'",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run test/unit --reporter=default --reporter=junit --outputFile=test-results/vitest-unit.xml",
    "test:package": "vitest run test/package --reporter=default --reporter=junit --outputFile=test-results/vitest-package.xml"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@eslint/js": "^9.14.0",
    "@kubb/cli": "^3.5.0",
    "@kubb/core": "^3.5.0",
    "@kubb/plugin-client": "^3.5.0",
    "@kubb/plugin-oas": "^3.5.0",
    "@kubb/plugin-ts": "^3.5.0",
    "@kubb/plugin-zod": "^3.5.0",
    "@redocly/cli": "1.34.5",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@stoplight/prism-cli": "5.16.0",
    "@types/node": "^22.9.0",
    "eslint": "^9.14.0",
    "eslint-plugin-security": "^3.0.1",
    "globals": "^15.12.0",
    "httpyac": "6.16.7",
    "prettier": "^3.3.3",
    "semantic-release": "^24.2.0",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0",
    "vitest": "^2.1.4",
    "yaml": "^2.6.0"
  }
}
